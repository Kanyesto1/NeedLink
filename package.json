    "validate:auth": "node scripts/auth-validate.js",
    "validate:rls": "node scripts/validate-rls.js",
    "validate:roles": "node scripts/check-deprecated-roles.js",
    "validate:headers": "node scripts/verify-security-headers.js",
    "validate:security": "node scripts/security-audit.js",
    "validate:operational": "node scripts/validate-operational.js",
    "validate:business": "node scripts/validate-business.js",
    "validate:all": "npm run validate:architecture && npm run validate:domain && npm run validate:database && npm run validate:auth && npm run validate:rls && npm run validate:roles && npm run validate:headers && npm run validate:security",
    "test:coverage": "vitest run --coverage",
