# Redis (optional — BullMQ workers, rate limiting, caching)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Backup
BACKUP_DIR=./backups
BACKUP_DB_CRON=0 2 * * *
BACKUP_STORAGE_CRON=0 3 * * *
BACKUP_CONFIG_CRON=0 4 * * *