# ──────────────────────────────────────────────
# NeedLink Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env.local for local development.
# Replace placeholder values with your actual configuration.
# ──────────────────────────────────────────────

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase (Cloud)
# Create a project at https://supabase.com and copy the credentials below.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage
STORAGE_PROVIDER=supabase
NEXT_PUBLIC_STORAGE_BUCKET=needlink-files

# Feature Flags
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_ENABLE_AI=false
NEXT_PUBLIC_ENABLE_PAYMENTS=false
NEXT_PUBLIC_ENABLE_CHAT=false

# Logging
LOG_LEVEL=debug

# Cache
CACHE_PROVIDER=in-memory

# Queue
QUEUE_PROVIDER=in-memory

# Redis (optional — BullMQ workers, rate limiting, caching)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Backup
BACKUP_DIR=./backups
BACKUP_DB_CRON=0 2 * * *
BACKUP_STORAGE_CRON=0 3 * * *
BACKUP_CONFIG_CRON=0 4 * * *
