NEXT_PUBLIC_ENABLE_PAYMENTS=false
NEXT_PUBLIC_ENABLE_CHAT=false

LOG_LEVEL=silent
CACHE_PROVIDER=in-memory
QUEUE_PROVIDER=in-memory
